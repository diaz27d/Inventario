{
  "name": "inventario",
  "version": "1.0.2",
  "description": "Sistema de inventario",
  "author": "Deivid Diaz",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "electron": "electron ."
  },
  "dependencies": {
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.inventario.app",
    "productName": "Inventario",
    "win": {
      "target": "nsis"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "backend/build",
        "to": "backend/build"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "backend/.env",
        "to": "backend/.env"
      },
      {
        "from": "backend/database",
        "to": "backend/database"
      },
      {
        "from": "node-runtime/node.exe",
        "to": "node/node.exe"
      }
    ]
  }
}
